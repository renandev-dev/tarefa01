meta {
  name: Criar Question
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/questions
  body: json
  auth: inherit
}

body:json {
  {
    "enunciado": "O que é REST?",
    "dificuldade": 2,
    "subjectId": {{subjectId}},
    "authorId": {{userId}}
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}

script:after-response {
  if (res.body.data && res.body.data.id) {
    bru.setVar("questionId", res.body.data.id);
  }
}
