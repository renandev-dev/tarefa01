meta {
  name: Criar User
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Prof. Bruno Teste",
    "email": "prof-{{$timestamp}}@escola.com",
    "senha": "senha123",
    "papel": "PROFESSOR"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}

script:after-response {
  // Salva o ID do usuário criado para Subject (professorId) e demais requests
  if (res.body.data && res.body.data.id) {
    bru.setVar("userId", res.body.data.id);
    bru.setVar("professorId", res.body.data.id);
  }
}
